{
  "name": "queryhub",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "node scripts/validate-env.mjs && next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "security:check": "node scripts/security-check.mjs",
    "security:client": "node scripts/check-client-secrets.mjs",
    "env:validate": "node scripts/validate-env.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1106.0",
    "@hookform/resolvers": "5.7.1",
    "@neondatabase/serverless": "^1.1.0",
    "@prisma/adapter-neon": "^7.9.1",
    "@prisma/client": "7.9.1",
    "bcryptjs": "3.0.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "dotenv": "^17.4.2",
    "lucide-react": "1.31.0",
    "next": "16.3.0",
    "next-auth": "4.24.15",
    "next-themes": "0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.85.0",
    "sanitize-html": "2.17.6",
    "server-only": "0.0.1",
    "sharp": "^0.35.3",
    "sonner": "2.0.8",
    "tailwind-merge": "3.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "1.55.1",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.17.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/sanitize-html": "2.16.1",
    "@typescript-eslint/eslint-plugin": "8.40.0",
    "@typescript-eslint/parser": "8.40.0",
    "autoprefixer": "10.4.21",
    "eslint": "9.33.0",
    "eslint-config-next": "16.2.10",
    "jsdom": "26.1.0",
    "postcss": "8.5.10",
    "prettier": "^3.6.2",
    "prisma": "6.19.3",
    "tailwindcss": "3.4.19",
    "tsx": "4.20.4",
    "typescript": "5.9.2",
    "vitest": "3.2.7"
  },
  "overrides": {
    "postcss": "8.5.10",
    "uuid": "11.1.1"
  }
}
