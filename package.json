{
  "name": "queryhub",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "node scripts/validate-env.mjs && next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:load": "node scripts/load-test.mjs",
    "notifications:digest": "tsx scripts/send-notification-digest.ts",
    "notifications:push": "tsx scripts/send-push-notifications.ts",
    "security:check": "node scripts/security-check.mjs",
    "security:client": "node scripts/check-client-secrets.mjs",
    "env:validate": "node scripts/validate-env.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1088.0",
    "@hookform/resolvers": "3.10.0",
    "@neondatabase/serverless": "^1.1.0",
    "@prisma/adapter-neon": "^6.19.3",
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.1.0",
    "dotenv": "^16.6.1",
    "lucide-react": "0.468.0",
    "next": "16.3.3",
    "next-auth": "4.24.15",
    "next-themes": "0.4.6",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-hook-form": "7.62.0",
    "sanitize-html": "2.17.7",
    "server-only": "0.0.1",
    "sharp": "0.35.4",
    "sonner": "2.0.7",
    "tailwind-merge": "3.3.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.5.1",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "@types/sanitize-html": "2.16.1",
    "@typescript-eslint/eslint-plugin": "8.70.0",
    "@typescript-eslint/parser": "8.70.0",
    "autoprefixer": "10.6.0",
    "eslint": "10.10.0",
    "eslint-config-next": "16.3.5",
    "jsdom": "30.0.1",
    "postcss": "8.5.28",
    "prettier": "^3.9.6",
    "prisma": "7.10.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "postcss": "8.5.28",
    "uuid": "11.1.1"
  }
}
