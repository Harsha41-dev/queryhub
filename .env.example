# Runtime mode. Production enables strict provider and HTTPS validation.
APP_ENV="development"
APP_URL="http://localhost:3000"

# Use a pooled PostgreSQL URL for the application and a direct URL for migrations.
DATABASE_URL="postgresql://queryhub:queryhub@localhost:5432/queryhub?schema=public"
DIRECT_URL="postgresql://queryhub:queryhub@localhost:5432/queryhub?schema=public"
# Use `neon` with Neon's pooled serverless URL; use `native` locally and in Docker.
DATABASE_ADAPTER="native"

# Authentication. Generate NEXTAUTH_SECRET with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-random-secret-of-at-least-32-characters"

# Optional Google OAuth. Configure both values or leave both empty.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Email. Local development logs messages; production must use Resend.
EMAIL_PROVIDER="log"
EMAIL_FROM="QueryHub <noreply@example.com>"
EMAIL_REPLY_TO=""
RESEND_API_KEY=""

# Rate limiting. Production must use the Upstash-compatible REST provider.
RATE_LIMIT_PROVIDER="memory"
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
# Trust forwarding headers only behind a configured reverse proxy such as Vercel.
# Set this to true in production so rate limiting uses the real client IP.
TRUST_PROXY="false"

# Avatar storage. Local files are re-encoded and stored outside version control.
STORAGE_PROVIDER="local"
MAX_UPLOAD_BYTES="5242880"
S3_REGION=""
S3_BUCKET=""
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""
S3_FORCE_PATH_STYLE="false"

# Readiness, structured logging, and optional monitoring.
READINESS_TOKEN="local-readiness-token-change-before-production"
LOG_LEVEL="info"
MONITORING_PROVIDER="log"
MONITORING_WEBHOOK_URL=""
MONITORING_WEBHOOK_TOKEN=""
SENTRY_DSN=""
SENTRY_ENVIRONMENT=""
SENTRY_RELEASE=""

# Optional privacy-conscious server-side analytics. Leave disabled locally.
ANALYTICS_PROVIDER="none"
ANALYTICS_WEBHOOK_URL=""
ANALYTICS_WEBHOOK_TOKEN=""
POSTHOG_PROJECT_API_KEY=""
POSTHOG_HOST="https://app.posthog.com"
ANALYTICS_ID=""

# Optional push notification delivery. Browser subscription needs a VAPID public key.
NEXT_PUBLIC_PUSH_VAPID_PUBLIC_KEY=""
PUSH_PROVIDER="none"
PUSH_WEBHOOK_URL=""
PUSH_WEBHOOK_TOKEN=""

# Optional seed guard. Only set this when intentionally seeding production.
ALLOW_PRODUCTION_SEED="false"
